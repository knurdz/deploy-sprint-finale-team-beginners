# Public deploy label (safe in browser). Set in GitHub Actions variables as PUBLIC_DEPLOY_LABEL
# and pass to Vite as VITE_PUBLIC_DEPLOY_LABEL at build time.
VITE_PUBLIC_DEPLOY_LABEL=<team-visible-label>

# Private deploy token — GitHub Secret PRIVATE_DEPLOY_TOKEN only. Never use VITE_ prefix.
# PRIVATE_DEPLOY_TOKEN=<fake-private-token-for-actions-only>

# T15 feature flag — set GitHub Secret or Variable FEATURE_SHOW_INSIGHTS to true|false.
# CI maps it to VITE_FEATURE_SHOW_INSIGHTS at build time. Do not commit real secret values.
# FEATURE_SHOW_INSIGHTS=false
# VITE_FEATURE_SHOW_INSIGHTS=false

# T16 Resend email alerts — GitHub Secret RESEND_API_KEY only (never VITE_ / never commit).
# Optional vars: RESEND_FROM_EMAIL, ALERT_RECIPIENT_EMAIL (test addresses only).
# EMAIL_PROVIDER=resend
# EMAIL_ALERT_MODE=dry-run
# RESEND_API_KEY=<github-secret-only>
# RESEND_FROM_EMAIL=<verified-or-test-sender>
# ALERT_RECIPIENT_EMAIL=<safe-test-recipient>

# T24 Cloudflare Turnstile — public site key OK; secret is GitHub Secret only.
# TURNSTILE_SITE_KEY=<public-widget-site-key>
# VITE_TURNSTILE_SITE_KEY=<optional-build-time-mirror-of-public-site-key>
# TURNSTILE_SECRET_KEY=<github-secret-only>
# TURNSTILE_VERIFY_MODE=dry-run
# TURNSTILE_ALLOWED_HOSTNAME=beginners.deploysprint-finals.knurdz.org
# Never expose TURNSTILE_SECRET_KEY through a Vite client env (browser bundle).
