# Public deploy label (safe in browser). Set in GitHub Actions variables as PUBLIC_DEPLOY_LABEL
# and pass to Vite as VITE_PUBLIC_DEPLOY_LABEL at build time.
VITE_PUBLIC_DEPLOY_LABEL=<team-visible-label>

# Private deploy token — GitHub Secret PRIVATE_DEPLOY_TOKEN only. Never use VITE_ prefix.
# PRIVATE_DEPLOY_TOKEN=<fake-private-token-for-actions-only>

# T15 feature flag — set GitHub Secret or Variable FEATURE_SHOW_INSIGHTS to true|false.
# CI maps it to VITE_FEATURE_SHOW_INSIGHTS at build time. Do not commit real secret values.
# FEATURE_SHOW_INSIGHTS=false
# VITE_FEATURE_SHOW_INSIGHTS=false
