# Runtime env for Docker Compose on the VPS — names and placeholders only.
# The organizer deployer generates the real file at RUNTIME_ENV_PATH during deploy.
# Do not commit a populated .env with secrets.

APP_VERSION=
APP_IMAGE=
APP_PORT=8080
PUBLIC_URL=
COMPOSE_PROJECT_NAME=deploy-sprint-team-01
SERVICE_NAME=deploy-sprint-team-01
RUNTIME_ENV_PATH=/opt/deploy-sprint/team-01/.env
TEAM_NAME=BEGINNERS
TEAM_SLUG=beginners
PUBLIC_DEPLOY_LABEL=

# Secret values are injected on the server from GitHub Actions secrets (names only here):
# PRIVATE_DEPLOY_TOKEN
# WEB3FORMS_ACCESS_KEY
# DEPLOYER_DISPATCH_TOKEN

# Sentry (T30) — DSN may be client-visible; auth token is Actions-only
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
